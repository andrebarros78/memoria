# Configuração sem credenciais. Valores secretos ficam fora da árvore do produto.
MEMORY_DATABASE_URL=postgresql://memory_app@127.0.0.1:55436/memoria_permanente
MEMORY_BIND_HOST=127.0.0.1
MEMORY_BIND_PORT=8787
MEMORY_VAULT_ROOT=C:\ProgramData\MemoriaPermanente\vault
MEMORY_AUTH_ROOT=C:\ProgramData\MemoriaPermanente\auth

# Obrigatórios somente se MEMORY_BIND_HOST não for loopback.
# MEMORY_TLS_CERTFILE=C:\ProgramData\MemoriaPermanente\tls\server.crt
# MEMORY_TLS_KEYFILE=C:\ProgramData\MemoriaPermanente\tls\server.key
