{
    "manifest_version":  3,
    "name":  "Memoria Permanente V4 - Conversation Capture",
    "version":  "1.3.0",
    "description":  "Captura autorizada write-through de turnos do ChatGPT para a Memoria Permanente V4.",
    "permissions":  [
                        "storage",
                        "alarms"
                    ],
    "host_permissions":  [
                             "https://chatgpt.com/*",
                             "https://desktop-jns08pu.tail7ad8aa.ts.net:8788/*",
                             "http://127.0.0.1:8787/*"
                         ],
    "background":  {
                       "service_worker":  "background.js"
                   },
    "content_scripts":  [
                            {
                                "matches":  [
                                                "https://chatgpt.com/*"
                                            ],
                                "js":  [
                                           "content.js"
                                       ],
                                "run_at":  "document_idle"
                            }
                        ],
    "options_page":  "options.html",
    "action":  {
                   "default_title":  "Memoria Permanente V4",
                   "default_popup":  "popup.html"
               }
}
